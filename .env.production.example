# Compose / Caddy
HUB_DOMAIN=hub.seudominio.com.br
HUB_API_DOMAIN=api.hub.seudominio.com.br
ACME_EMAIL=admin@seudominio.com.br
NEXT_PUBLIC_API_TIMEOUT_MS=30000

# Database
POSTGRES_USER=hub
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=hub

# Backend security
JWT_SECRET=change-this-minimum-32-characters-secret
JWT_REFRESH_SECRET=change-this-minimum-32-characters-refresh-secret

# Feature flags
ALLOW_PUBLIC_REGISTER=false
RULE_PROFILE_ENGINE_ENABLED=true
RULE_PROFILE_BLOCK_ON_MISSING_CLASSIFICATION=true
COMMERCIAL_REQUIREMENT_GATES_ENABLED=false
COMMERCIAL_PUBLIC_SCHEDULING_ENABLED=false
COMMERCIAL_QUALIFICATION_SCORE_ENABLED=false
COMMERCIAL_SCHEDULING_INVITE_HYBRID_ENABLED=false
COMMERCIAL_SCHEDULING_QUICK_CONFIRM_ENABLED=false
COMMERCIAL_TEMPLATE_STRICT_MODE_ENABLED=false
COMMERCIAL_GOOGLE_BOOKING_ENABLED=false
COMMERCIAL_GOOGLE_BOOKING_SYNC_ENABLED=false
COMMERCIAL_RUNTIME_JOBS_ENABLED=false
COMMERCIAL_GOOGLE_BOOKING_FALLBACK_TO_PUBLIC_ENABLED=true
COMMERCIAL_WHATSAPP_INTERACTIVE_SCHEDULING_ENABLED=false
COMMERCIAL_WHATSAPP_REPLY_AUTOCONFIRM_ENABLED=false
COMMERCIAL_WHATSAPP_INTERACTIVE_FALLBACK_TEXT_ENABLED=true

# Meta Ads API
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v20.0
META_SYNC_MAX_DAYS=365
META_SYNC_CHUNK_DAYS=30

# OpenAI
OPENAI_API_KEY=
AI_OUTPUT_CACHE_HOURS=24

# Email
RESEND_API_KEY=
FROM_EMAIL=noreply@seudominio.com.br

# WhatsApp / Evolution API
EVOLUTION_API_BASE_URL=https://evolution.seudominio.com.br
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

# Scheduling webhooks
COMMERCIAL_SCHEDULING_SLOTS_WEBHOOK_URL=
COMMERCIAL_SCHEDULING_CONFIRM_WEBHOOK_URL=
COMMERCIAL_SCHEDULING_UPDATE_WEBHOOK_URL=
COMMERCIAL_SCHEDULING_CANCEL_WEBHOOK_URL=

# Google integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GMAIL_FROM_ADDRESS=contato@seudominio.com.br
