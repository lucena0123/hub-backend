{
  "name": "Hub Scheduling Update",
  "nodes": [
    {
      "id": "Webhook_1",
      "name": "Webhook Update",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 280],
      "parameters": {
        "path": "hub/scheduling/update",
        "responseMode": "responseNode",
        "httpMethod": "POST"
      }
    },
    {
      "id": "Token_1",
      "name": "Google Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 280],
      "parameters": {
        "method": "POST",
        "url": "https://oauth2.googleapis.com/token",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/x-www-form-urlencoded" }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "client_id", "value": "={{$env.GOOGLE_CLIENT_ID || ''}}" },
            { "name": "client_secret", "value": "={{$env.GOOGLE_CLIENT_SECRET || ''}}" },
            { "name": "refresh_token", "value": "={{$env.GOOGLE_REFRESH_TOKEN || ''}}" },
            { "name": "grant_type", "value": "refresh_token" }
          ]
        }
      }
    },
    {
      "id": "Patch_1",
      "name": "Calendar Patch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 280],
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://www.googleapis.com/calendar/v3/calendars/' + encodeURIComponent($env.GOOGLE_CALENDAR_ID || 'primary') + '/events/' + encodeURIComponent($node['Webhook Update'].json.body.eventId || '') }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$json.access_token}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { summary: 'Diagnóstico Comercial (Remarcado)', description: 'Lead ' + ($node['Webhook Update'].json.body.leadId || ''), start: { dateTime: $node['Webhook Update'].json.body.slotStart, timeZone: $node['Webhook Update'].json.body.timezone || 'America/Sao_Paulo' }, end: { dateTime: $node['Webhook Update'].json.body.slotEnd, timeZone: $node['Webhook Update'].json.body.timezone || 'America/Sao_Paulo' }, attendees: $node['Webhook Update'].json.body.attendeeEmail ? [{ email: $node['Webhook Update'].json.body.attendeeEmail, displayName: $node['Webhook Update'].json.body.attendeeName || 'Cliente' }] : [] } }}"
      }
    },
    {
      "id": "Resp_1",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [1060, 280],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, provider: 'google-calendar', eventId: $json.id || $node['Webhook Update'].json.body.eventId || ('cal_' + Date.now()) } }}",
        "options": { "responseCode": 200 }
      }
    }
  ],
  "connections": {
    "Webhook Update": { "main": [[{ "node": "Google Token", "type": "main", "index": 0 }]] },
    "Google Token": { "main": [[{ "node": "Calendar Patch", "type": "main", "index": 0 }]] },
    "Calendar Patch": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
