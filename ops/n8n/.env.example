# n8n self-host (recommended baseline)
N8N_HOST=n8n.seudominio.com
N8N_PROTOCOL=https
N8N_PORT=5678
N8N_EDITOR_BASE_URL=https://n8n.seudominio.com
WEBHOOK_URL=https://n8n.seudominio.com/

# Segurança
N8N_ENCRYPTION_KEY=troque-por-uma-chave-forte
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=troque-essa-senha

# Banco (Postgres dedicado do n8n)
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=troque-essa-senha

# Timezone
GENERIC_TIMEZONE=America/Sao_Paulo

# Redis (opcional para escala)
QUEUE_BULL_REDIS_HOST=redis
QUEUE_BULL_REDIS_PORT=6379
