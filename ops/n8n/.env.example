# n8n self-host (recommended baseline)
N8N_HOST=n8n.seudominio.com
N8N_PROTOCOL=https
N8N_PORT=5678
N8N_EDITOR_BASE_URL=https://n8n.seudominio.com
WEBHOOK_URL=https://n8n.seudominio.com/

# Segurança
N8N_ENCRYPTION_KEY=troque-por-uma-chave-forte
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=troque-essa-senha

# Banco (Postgres dedicado do n8n)
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=troque-essa-senha

# Shared token for Hub dispatch webhook auth
DISPATCH_SHARED_TOKEN=troque-por-token-forte

# Evolution API (WhatsApp oficial no workflow Hub Dispatch WhatsApp)
EVOLUTION_API_BASE_URL=https://evolution.seudominio.com
EVOLUTION_INSTANCE=nome-da-instancia
EVOLUTION_API_KEY=troque-por-apikey

# Google Calendar (próximo bloco: disponibilidade + agendamento)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Timezone
GENERIC_TIMEZONE=America/Sao_Paulo

# Redis (opcional para escala)
QUEUE_BULL_REDIS_HOST=redis
QUEUE_BULL_REDIS_PORT=6379
