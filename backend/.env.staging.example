# Staging environment example for Google Booking flow
# Copy to your staging secret manager /.env and replace placeholders.

# Core
NODE_ENV="production"
PORT=3001
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
JWT_SECRET="<MIN_32_CHAR_SECRET>"

# Public origins
FRONTEND_URL="https://staging.seu-dominio.com"
APP_BASE_URL="https://staging.seu-dominio.com"
HUB_FORMS_BASE_URL="https://staging.seu-dominio.com"
HUB_API_BASE_URL="https://api-staging.seu-dominio.com"

# Commercial scheduling flags
COMMERCIAL_PUBLIC_SCHEDULING_ENABLED="true"
COMMERCIAL_SCHEDULING_INVITE_HYBRID_ENABLED="true"
COMMERCIAL_SCHEDULING_QUICK_CONFIRM_ENABLED="false"
COMMERCIAL_GOOGLE_BOOKING_ENABLED="true"
COMMERCIAL_GOOGLE_BOOKING_SYNC_ENABLED="true"
COMMERCIAL_RUNTIME_JOBS_ENABLED="false"
COMMERCIAL_GOOGLE_BOOKING_FALLBACK_TO_PUBLIC_ENABLED="true"
COMMERCIAL_WHATSAPP_INTERACTIVE_SCHEDULING_ENABLED="false"
COMMERCIAL_WHATSAPP_REPLY_AUTOCONFIRM_ENABLED="false"
COMMERCIAL_WHATSAPP_INTERACTIVE_FALLBACK_TEXT_ENABLED="true"
EVOLUTION_WEBHOOK_SECRET="<WEBHOOK_SECRET>"
