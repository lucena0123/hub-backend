# Database
# Local (docker-compose): Postgres exposto em localhost:5433
DATABASE_URL="postgresql://bpmn:dev123@localhost:5433/bpmn_system"

# Redis
REDIS_URL="redis://localhost:6380"

# JWT
JWT_SECRET="your-secret-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production-min-32-chars"

# Server
PORT=3001
NODE_ENV="development"
ALLOW_PUBLIC_REGISTER="true"

# Meta Ads API
META_APP_ID=""
META_APP_SECRET=""
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""
META_API_VERSION="v20.0"
# Meta sync guardrails (set META_SYNC_MAX_DAYS=0 to disable)
META_SYNC_MAX_DAYS=365
META_SYNC_CHUNK_DAYS=30

# OpenAI (para IA de relatórios)
OPENAI_API_KEY=""
AI_OUTPUT_CACHE_HOURS=24

# Email (Resend)
RESEND_API_KEY=""
FROM_EMAIL="noreply@lucenasolucoesdigitais.com.br"

# Frontend URL (CORS origin). Múltiplas origens: separe por vírgula.
# Produção: "https://lucenasolucoesdigitais.com.br,https://www.lucenasolucoesdigitais.com.br"
# Dev local: "http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Base URL do app (usada para gerar links de formulários e propostas)
# Produção: "https://lucenasolucoesdigitais.com.br"
APP_BASE_URL="http://localhost:3000"
HUB_FORMS_BASE_URL="http://localhost:3000"

# WhatsApp (Evolution API — integração direta, sem n8n)
EVOLUTION_API_BASE_URL="https://evolution.lucenasolucoesdigitais.com.br"
EVOLUTION_INSTANCE="nome-da-instancia"
EVOLUTION_API_KEY=""

# Gmail + Google Calendar (OAuth2 — integração direta, sem n8n)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID="primary"
GMAIL_FROM_ADDRESS="contato@lucenasolucoesdigitais.com.br"

# ---------------------------------------------------------------------------
# Frontend (frontend/.env.local) — documentado aqui por referência
# O frontend ignora .env* no .gitignore; copie manualmente ao fazer deploy.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:3001
# Produção: NEXT_PUBLIC_API_URL=https://api.lucenasolucoesdigitais.com.br
