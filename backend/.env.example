# Database
# Local (docker-compose): Postgres exposto em localhost:5433
DATABASE_URL="postgresql://bpmn:dev123@localhost:5433/bpmn_system"

# Redis
REDIS_URL="redis://localhost:6380"

# JWT
JWT_SECRET="your-secret-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production-min-32-chars"

# Server
PORT=3001
NODE_ENV="development"
ALLOW_PUBLIC_REGISTER="true"

# Meta Ads API
META_APP_ID=""
META_APP_SECRET=""
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""
META_API_VERSION="v20.0"
# Meta sync guardrails (set META_SYNC_MAX_DAYS=0 to disable)
META_SYNC_MAX_DAYS=365
META_SYNC_CHUNK_DAYS=30

# OpenAI (para IA de relatórios)
OPENAI_API_KEY=""
AI_OUTPUT_CACHE_HOURS=24

# Email (Resend)
RESEND_API_KEY=""
FROM_EMAIL="noreply@yourdomain.com"

# Frontend URL (CORS)
FRONTEND_URL="http://localhost:3000"

# Comercial dispatch webhooks
COMMERCIAL_DISPATCH_WHATSAPP_WEBHOOK_URL=""
COMMERCIAL_DISPATCH_GMAIL_WEBHOOK_URL=""
COMMERCIAL_DISPATCH_WEBHOOK_SIGNING_SECRET=""
COMMERCIAL_DISPATCH_SHARED_TOKEN=""
COMMERCIAL_DISPATCH_WEBHOOK_TIMEOUT_MS="8000"
COMMERCIAL_DISPATCH_WEBHOOK_MAX_RETRIES="2"
COMMERCIAL_DISPATCH_WEBHOOK_RETRY_BASE_MS="500"
# Opcional: mapa JSON para templates quando templateKey não for enviado.
# Suporta formato plano por etapa:
# {"primeiro_contato":"tmpl_01","proposta_enviada":"tmpl_03"}
# Ou formato por canal+etapa:
# {"whatsapp":{"primeiro_contato":"wa_01"},"gmail":{"proposta_enviada":"gm_03"}}
# Exemplo completo: docs/commercial-dispatch-template-map.example.json
COMMERCIAL_DISPATCH_TEMPLATE_MAP_JSON=""

# Scheduling webhooks (n8n/google calendar block)
COMMERCIAL_SCHEDULING_SLOTS_WEBHOOK_URL=""
COMMERCIAL_SCHEDULING_CONFIRM_WEBHOOK_URL=""
COMMERCIAL_SCHEDULING_UPDATE_WEBHOOK_URL=""
COMMERCIAL_SCHEDULING_CANCEL_WEBHOOK_URL=""
COMMERCIAL_SCHEDULING_TEMP_RELAY_ENABLED="false"
COMMERCIAL_SCHEDULING_RELAY_SECRET=""

# Relay temporário (fallback enquanto provedores finais não estão configurados)
COMMERCIAL_DISPATCH_TEMP_RELAY_ENABLED="false"
COMMERCIAL_DISPATCH_TEMP_RELAY_BASE_URL="http://127.0.0.1:3001"
COMMERCIAL_DISPATCH_RELAY_SECRET=""
