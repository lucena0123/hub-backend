# Database
# Local (docker-compose): Postgres exposto em localhost:5433
DATABASE_URL="postgresql://bpmn:dev123@localhost:5433/bpmn_system"

# Redis
REDIS_URL="redis://localhost:6380"

# JWT
JWT_SECRET="your-secret-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production-min-32-chars"

# Server
PORT=3001
NODE_ENV="development"
ALLOW_PUBLIC_REGISTER="true"

# Meta Ads API
META_APP_ID=""
META_APP_SECRET=""
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""
META_API_VERSION="v20.0"
# Meta sync guardrails (set META_SYNC_MAX_DAYS=0 to disable)
META_SYNC_MAX_DAYS=365
META_SYNC_CHUNK_DAYS=30

# OpenAI (para IA de relatórios)
OPENAI_API_KEY=""
AI_OUTPUT_CACHE_HOURS=24

# Email (Resend)
RESEND_API_KEY=""
FROM_EMAIL="noreply@yourdomain.com"

# Frontend URL (CORS)
FRONTEND_URL="http://localhost:3000"
