{
  "name": "@bpmn-system/api",
  "version": "1.0.0",
  "description": "BPMN System - Backend API",
  "main": "dist/server-pg.js",
  "scripts": {
    "dev": "tsx watch src/server-pg.ts",
    "build": "tsc",
    "start": "node dist/server-pg.js",
    "seed:mock": "tsx src/seed-mock.ts",
    "cleanup:mock": "tsx src/cleanup-mock.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke:relay": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke-commercial-relay.ps1",
    "env:dispatch:n8n": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-dispatch-env-from-1password.ps1"
  },
  "keywords": [
    "bpmn",
    "fastify",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@prisma/client": "^6.1.0",
    "@types/pg": "^8.16.0",
    "ajv": "^8.17.1",
    "axios": "^1.13.4",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.67.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.9.2",
    "json-logic-js": "^2.0.5",
    "pg": "^8.18.0",
    "puppeteer": "^24.36.1",
    "redis": "^4.7.0",
    "uuid": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "jsonwebtoken": "^9.0.3",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  }
