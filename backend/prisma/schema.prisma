  status      String       @default("planned")
  ownerUserId String?      @map("owner_user_id")
  startDate   DateTime     @map("start_date") @db.Date
  dueDate     DateTime?    @map("due_date") @db.Date
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contract    Contract?    @relation(fields: [contractId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  milestones  Milestone[]
  deliverables Deliverable[]
  workItems   WorkItem[]

  @@index([clientId, status], map: "idx_projects_client_status")
  @@index([contractId], map: "idx_projects_contract")
  @@map("projects")
}

model Milestone {
  id         String    @id @default(uuid())
  projectId  String    @map("project_id")
  name       String
  status     String    @default("planned")
  orderIndex Int       @default(0) @map("order_index")
  dueDate    DateTime? @map("due_date") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  deliverables Deliverable[]

  @@index([projectId, status], map: "idx_milestones_project_status")
  @@map("milestones")
}

model Deliverable {
  id            String     @id @default(uuid())
  projectId     String     @map("project_id")
  milestoneId   String?    @map("milestone_id")
  name          String
  description   String?
  status        String     @default("planned")
  blockedReason String?    @map("blocked_reason")
  dueDate       DateTime?  @map("due_date") @db.Date
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  milestone     Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  workItems     WorkItem[]

  @@index([projectId, status], map: "idx_deliverables_project_status")
  @@index([milestoneId], map: "idx_deliverables_milestone")
  @@map("deliverables")
}

model WorkItem {
  id            String       @id @default(uuid())
  projectId      String      @map("project_id")
  deliverableId  String?     @map("deliverable_id")
  title          String
  status         String      @default("planned")
  assignee       String?
  priority       String      @default("normal")
  dueDate        DateTime?   @map("due_date") @db.Date
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  deliverable    Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([projectId, status], map: "idx_work_items_project_status")
  @@index([deliverableId], map: "idx_work_items_deliverable")
  @@map("work_items")
}

model OnboardingPlan {
  id           String           @id @default(uuid())
  clientId     String           @map("client_id")
  contractId   String           @map("contract_id")
  status       String           @default("onboarding")
  startedAt    DateTime         @default(now()) @map("started_at") @db.Timestamp(6)
  targetDate   DateTime?        @map("target_date") @db.Date
  completedAt  DateTime?        @map("completed_at") @db.Timestamp(6)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contract     Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tasks        OnboardingTask[]

  @@unique([contractId], map: "onboarding_plans_contract_key")
  @@index([clientId, status], map: "idx_onboarding_plans_client_status")
  @@map("onboarding_plans")
}

model OnboardingTask {
  id           String         @id @default(uuid())
  planId        String        @map("plan_id")
  taskKey       String        @map("task_key")
  title         String
  status        String        @default("pending")
  dueDate       DateTime?     @map("due_date") @db.Date
  completedAt   DateTime?     @map("completed_at") @db.Timestamp(6)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  plan          OnboardingPlan @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([planId, taskKey], map: "onboarding_tasks_plan_task_key_key")
  @@index([planId, status], map: "idx_onboarding_tasks_plan_status")
  @@map("onboarding_tasks")
}

model HealthSnapshot {
  id           String        @id @default(uuid())
  clientId     String        @map("client_id")
  contractId   String?       @map("contract_id")
  snapshotDate DateTime      @map("snapshot_date") @db.Date
  status       String
  score        Int
  summary      Json?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contract     Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  signals      HealthSignal[]

  @@unique([clientId, contractId, snapshotDate], map: "health_snapshots_client_contract_date_key")
  @@index([status, snapshotDate], map: "idx_health_snapshots_status_date")
  @@map("health_snapshots")
}

model HealthSignal {
  id         String         @id @default(uuid())
  snapshotId String         @map("snapshot_id")
  signalType String         @map("signal_type")
  severity   String
  source     String
  message    String
  metadata   Json?
  createdAt  DateTime       @default(now()) @map("created_at")
  snapshot   HealthSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([snapshotId], map: "idx_health_signals_snapshot")
  @@map("health_signals")
}

model AccountReview {
  id          String    @id @default(uuid())
  clientId     String   @map("client_id")
  contractId   String?  @map("contract_id")
  reviewDate   DateTime @map("review_date") @db.Date
  reviewType   String   @map("review_type")
  notes        String?
  ownerUserId  String?  @map("owner_user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contract     Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([clientId, reviewDate], map: "idx_account_reviews_client_review_date")
  @@map("account_reviews")
}

model ExpansionOpportunity {
  id            String    @id @default(uuid())
  clientId       String   @map("client_id")
  contractId     String?  @map("contract_id")
  status         String   @default("open")
  title          String
  notes          String?
  estimatedMrr   Decimal? @map("estimated_mrr") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contract       Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([clientId, status], map: "idx_expansion_opportunities_client_status")
  @@map("expansion_opportunities")
}

model OptimizationPlaybookRule {
  id                 String   @id
  title              String
  description        String
  condition          String
  level              String
  severity           String
  category           String
  action             String
  parametersSchema   Json?    @map("parameters_schema")
  parametersTemplate Json?    @map("parameters_template")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("optimization_playbook_rules")
}
