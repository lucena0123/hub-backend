generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id                             String                  @id @default(uuid())
  name                           String
  email                          String                  @unique
  tier                           String
  status                         String
  contractStart                  DateTime                @db.Timestamp(6)
  contractEnd                    DateTime?               @db.Timestamp(6)
  budget                         Float
  businessNicheKey               String?                 @map("business_niche_key")
  defaultChannelKey              String?                 @map("default_channel_key")
  createdAt                      DateTime                @default(now()) @db.Timestamp(6)
  updatedAt                      DateTime                @updatedAt @db.Timestamp(6)
  avg_client_lifetime_months     Decimal?                @db.Decimal(6, 1)
  avg_monthly_revenue_per_client Decimal?                @db.Decimal(12, 2)
  metaAdAccountId                String?
  optimization_targets           Json?
  action_proposals               action_proposals[]
  anomaly_detections             anomaly_detections[]
  campaigns                      Campaign[]
  client_bpmn_progress           ClientBPMNProgress[]
  metrics                        metrics[]
  monthlyReports                 MonthlyReport[]
  notifications                  notifications[]
  processes                      ProcessInstance[]
  weekly_summaries               weekly_summaries[]
  ai_copy_suggestions            ai_copy_suggestions[]
  auto_approval_history          auto_approval_history[]
  client_rule_configs            ClientRuleConfig[]
  client_rule_profile_bindings   ClientRuleProfileBinding[]
  contracts                      Contract[]
  receivables                    Receivable[]
  renewalOpportunities           RenewalOpportunity[]
  projects                       Project[]
  onboardingPlans                OnboardingPlan[]
  healthSnapshots                HealthSnapshot[]
  accountReviews                 AccountReview[]
  expansionOpportunities         ExpansionOpportunity[]
  metaGovernanceIssues           MetaGovernanceIssue[]
  metaNamingOverrides            MetaNamingOverride[]
  @@map("clients")
}

model ProcessInstance {
  id           String    @id @default(uuid())
  processId    String
  version      String
  status       String
  priority     Int       @default(5)
  clientId     String
  startedAt    DateTime  @default(now()) @db.Timestamp(6)
  completedAt  DateTime? @db.Timestamp(6)
  expectedSla  String
  slaBreached  Boolean   @default(false)
  currentPhase String?
  currentTask  String?
  state        Json
  client       Client    @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tasks        Task[]

  @@index([clientId])
  @@index([status])
  @@index([processId])
  @@map("process_instances")
}

model Task {
  id                String          @id @default(uuid())
  taskId            String
  name              String
  lane              String
  status            String
  priority          Int             @default(5)
  processInstanceId String
  assignedTo        String?
  startedAt         DateTime?       @db.Timestamp(6)
  completedAt       DateTime?       @db.Timestamp(6)
  durationMs        Int?
  input             Json?
  output            Json?
  error             String?
  processInstance   ProcessInstance @relation(fields: [processInstanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([processInstanceId])
  @@index([status])
  @@index([assignedTo])
  @@map("tasks")
}

model Campaign {
  id                     String                   @id @default(uuid())
  externalId             String                   @unique
  platform               String
  name                   String
  status                 String
  clientId               String
  budget                 Float
  spent                  Float                    @default(0)
  createdAt              DateTime                 @default(now()) @db.Timestamp(6)
  updatedAt              DateTime                 @updatedAt @db.Timestamp(6)
  createdTime            DateTime?                @map("created_time") @db.Timestamp(6)
  objective              String?
  objectiveClassKey      String?                  @map("objective_class_key")
  channelClassKey        String?                  @map("channel_class_key")
  ruleProfileId          String?                  @map("rule_profile_id")
  optimizationThemeKey   String?                  @map("optimization_theme_key")
  optimizationSubthemeKey String?                 @map("optimization_subtheme_key")
  ad_creative_metrics    AdMetric[]
  adsets                 AdSet[]
  adset_metrics          AdSetMetric[]
  campaign_ads           campaign_ads[]
  campaign_lead_tracking campaign_lead_tracking[]
  metrics                CampaignMetric[]
  client                 Client                   @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  simple_metrics         metrics[]
  breakdowns             MetricsBreakdown[]
  adsetBudgetHistory     AdSetBudgetHistory[]
  campaignRuleContext    CampaignRuleContext?
  client_rule_configs    ClientRuleConfig[]
  ruleProfile            RuleProfile?             @relation("CampaignRuleProfile", fields: [ruleProfileId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  metaGovernanceIssues    MetaGovernanceIssue[]
  @@index([clientId])
  @@index([platform])
  @@index([objectiveClassKey])
  @@index([channelClassKey])
  @@index([ruleProfileId])
  @@map("campaigns")
}

model AdSet {
  id              String    @id
  campaignId      String    @map("campaign_id")
  adsetId         String    @map("adset_id")
  adsetName       String?   @map("adset_name")
  status          String?
  effectiveStatus String?   @map("effective_status")
  dailyBudget     Decimal?  @default(0) @map("daily_budget") @db.Decimal(10, 2)
  lifetimeBudget  Decimal?  @default(0) @map("lifetime_budget") @db.Decimal(10, 2)
  learningStatus  String?   @map("learning_status")
  learningStageInfo Json?   @map("learning_stage_info")
  learningStatusUpdatedAt DateTime? @map("learning_status_updated_at") @db.Timestamp(6)
  lastSignificantEdit DateTime? @map("last_significant_edit") @db.Timestamp(6)
  platform        String?   @default("meta")
  metadata        Json?
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  createdTime     DateTime? @map("created_time") @db.Timestamp(6)
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([adsetId, platform])
  @@index([campaignId], map: "idx_adsets_campaign")
  @@index([adsetId], map: "idx_adsets_adset")
  @@index([platform], map: "idx_adsets_platform")
  @@map("adsets")
}

model CampaignMetric {
  id                     String    @id @default(uuid())
  campaignId             String    @map("campaign_id")
  date                   DateTime  @db.Date
  impressions            Int?      @default(0)
  clicks                 Int?      @default(0)
  conversions            Int?      @default(0)
  spend                  Decimal?  @default(0) @db.Decimal(10, 2)
  ctr                    Decimal?  @default(0) @db.Decimal(5, 2)
  cpc                    Decimal?  @default(0) @db.Decimal(10, 2)
  cpl                    Decimal?  @default(0) @db.Decimal(10, 2)
  cpa                    Decimal?  @default(0) @db.Decimal(10, 2)
  roas                   Decimal?  @default(0) @db.Decimal(10, 2)
  leads                  Int?      @default(0)
  qualified_leads        Int?      @default(0)
  revenue                Decimal?  @default(0) @db.Decimal(10, 2)
  platform               String?
  metadata               Json?
  createdAt              DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt              DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  messagingConversations Int?      @default(0) @map("messaging_conversations")
  messagingFirstReply    Int?      @default(0) @map("messaging_first_reply")
  linkClicks             Int?      @default(0) @map("link_clicks")
  landingPageViews       Int?      @default(0) @map("landing_page_views")
  reach                  Int?      @default(0)
  frequency              Decimal?  @default(0) @db.Decimal(8, 4)
  cpm                    Decimal?  @default(0) @db.Decimal(10, 2)
  qualityRanking         String?   @map("quality_ranking")
  engagementRateRanking  String?   @map("engagement_rate_ranking")
  conversionRateRanking  String?   @map("conversion_rate_ranking")
  campaign               Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([campaignId, date, platform])
  @@index([campaignId, date(sort: Desc)], map: "idx_campaign_metrics_campaign_date")
  @@index([campaignId], map: "idx_campaign_metrics_campaign_id")
  @@index([date], map: "idx_campaign_metrics_date")
  @@index([platform], map: "idx_campaign_metrics_platform")
  @@map("campaign_metrics")
}

model AdSetMetric {
  id                      String    @id @default(uuid())
  campaign_id             String
  adSetId                 String    @map("adset_id")
  adset_name              String?
  date                    DateTime  @db.Date
  impressions             Int?      @default(0)
  reach                   Int?      @default(0)
  clicks                  Int?      @default(0)
  linkClicks              Int?      @default(0) @map("link_clicks")
  landingPageViews        Int?      @default(0) @map("landing_page_views")
  spend                   Decimal?  @default(0) @db.Decimal(10, 2)
  conversions             Int?      @default(0)
  leads                   Int?      @default(0)
  messagingConversations  Int?      @default(0) @map("messaging_conversations")
  messaging_first_reply   Int?      @default(0)
  actionsByType           Json?     @map("actions_by_type")
  actionValuesByType      Json?     @map("action_values_by_type")
  ctr                     Decimal?  @default(0) @db.Decimal(5, 2)
  cpc                     Decimal?  @default(0) @db.Decimal(10, 2)
  cpl                     Decimal?  @default(0) @db.Decimal(10, 2)
  cpm                     Decimal?  @default(0) @db.Decimal(10, 2)
  frequency               Decimal?  @default(0) @db.Decimal(8, 4)
  quality_ranking         String?
  engagement_rate_ranking String?
  conversion_rate_ranking String?
  platform                String?   @default("meta")
  metadata                Json?
  createdAt               DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  campaigns               Campaign  @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([adSetId, date, platform])
  @@index([adSetId], map: "idx_adset_metrics_adset")
  @@index([campaign_id], map: "idx_adset_metrics_campaign")
  @@index([campaign_id, date(sort: Desc)], map: "idx_adset_metrics_campaign_date")
  @@index([date(sort: Desc)], map: "idx_adset_metrics_date")
  @@map("adset_metrics")
}

model AdSetBudgetHistory {
  id                   String    @id @default(uuid())
  campaignId           String    @map("campaign_id")
  adsetId              String    @map("adset_id")
  date                 DateTime  @db.Date
  dailyBudget          Decimal?  @default(0) @map("daily_budget") @db.Decimal(10, 2)
  lifetimeBudget       Decimal?  @default(0) @map("lifetime_budget") @db.Decimal(10, 2)
  status               String?
  effectiveStatus      String?   @map("effective_status")
  configuredStatus     String?   @map("configured_status")
  learningStatus       String?   @map("learning_status")
  lastSignificantEdit  DateTime? @map("last_significant_edit") @db.Timestamp(6)
  learningStageInfo    Json?     @map("learning_stage_info")
  metadata             Json?
  platform             String?   @default("meta")
  createdAt            DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  campaign             Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([adsetId, date, platform])
  @@index([campaignId], map: "idx_adset_budget_history_campaign")
  @@index([adsetId], map: "idx_adset_budget_history_adset")
  @@index([date(sort: Desc)], map: "idx_adset_budget_history_date")
  @@map("adset_budget_history")
}

model AdMetric {
  id                      String    @id @default(uuid())
  campaignId              String    @map("campaign_id")
  adsetId                 String?   @map("adset_id")
  adId                    String    @map("ad_id")
  adName                  String?   @map("ad_name")
  date                    DateTime  @db.Date
  impressions             Int?      @default(0)
  reach                   Int?      @default(0)
  clicks                  Int?      @default(0)
  linkClicks              Int?      @default(0) @map("link_clicks")
  landingPageViews        Int?      @default(0) @map("landing_page_views")
  spend                   Decimal?  @default(0) @db.Decimal(10, 2)
  conversions             Int?      @default(0)
  messagingConversations  Int?      @default(0) @map("messaging_conversations")
  ctr                     Decimal?  @default(0) @db.Decimal(5, 2)
  cpc                     Decimal?  @default(0) @db.Decimal(10, 2)
  cpl                     Decimal?  @default(0) @db.Decimal(10, 2)
  cpm                     Decimal?  @default(0) @db.Decimal(10, 2)
  videoThruplay           Int?      @default(0) @map("video_thruplay")
  videoP25                Int?      @default(0) @map("video_p25")
  videoP50                Int?      @default(0) @map("video_p50")
  videoP75                Int?      @default(0) @map("video_p75")
  videoP100               Int?      @default(0) @map("video_p100")
  video3SecViews          Int?      @default(0) @map("video_3sec_views")
  hookRate                Decimal?  @default(0) @map("hook_rate") @db.Decimal(5, 2)
  holdRate                Decimal?  @default(0) @map("hold_rate") @db.Decimal(5, 2)
  quality_ranking         String?
  engagement_rate_ranking String?
  conversion_rate_ranking String?
  platform                String?   @default("meta")
  metadata                Json?
  createdAt               DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  adCreatedTime           DateTime? @map("ad_created_time") @db.Timestamp(6)
  creativeId              String?   @map("creative_id")
  creativeSnapshotId      String?   @map("creative_snapshot_id")
  campaigns               Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([adId, date, platform])
  @@index([adId], map: "idx_ad_creative_ad")
  @@index([adsetId], map: "idx_ad_creative_adset")
  @@index([campaignId], map: "idx_ad_creative_campaign")
  @@index([date(sort: Desc)], map: "idx_ad_creative_date")
  @@index([creativeId], map: "idx_ad_creative_metrics_creative_id")
  @@index([creativeSnapshotId], map: "idx_ad_creative_metrics_snapshot_id")
  @@map("ad_creative_metrics")
}

model AdCreativeSnapshot {
  id                     String                  @id @default(uuid())
  creativeId             String                  @map("creative_id")
  platform               String?                 @default("meta")
  contentHash            String                  @map("content_hash")
  captured_at            DateTime?               @default(now()) @db.Timestamp(6)
  lastSeenAt             DateTime?               @default(now()) @map("last_seen_at") @db.Timestamp(6)
  headline               String?
  primaryText            String?                 @map("primary_text")
  description            String?
  ctaType                String?                 @map("cta_type")
  destinationUrl         String?                 @map("destination_url")
  imageUrl               String?                 @map("image_url")
  thumbnailUrl           String?                 @map("thumbnail_url")
  videoId                String?                 @map("video_id")
  format                 String?
  isDynamic              Boolean?                @default(false) @map("is_dynamic")
  headlines              Json?
  primaryTexts           Json?                   @map("primary_texts")
  descriptions           Json?
  ctaTypes               Json?                   @map("cta_types")
  destinationUrls        Json?                   @map("destination_urls")
  objectStorySpec        Json?                   @map("object_story_spec")
  assetFeedSpec          Json?                   @map("asset_feed_spec")
  raw                    Json?
  visualAttributes       Json?                   @map("visual_attributes")
  creative_copy_insights creative_copy_insights?

  @@unique([creativeId, contentHash, platform])
  @@index([creativeId], map: "idx_ad_creative_snapshots_creative")
  @@index([lastSeenAt(sort: Desc)], map: "idx_ad_creative_snapshots_last_seen")
  @@index([platform], map: "idx_ad_creative_snapshots_platform")
  @@map("ad_creative_snapshots")
}

model MetricsBreakdown {
  id               String    @id @default(uuid())
  campaignId       String    @map("campaign_id")
  date             DateTime  @db.Date
  breakdownType    String    @map("breakdown_type")
  breakdownData    Json      @default("[]") @map("breakdown_data")
  totalSpend       Decimal?  @default(0) @map("total_spend") @db.Decimal(10, 2)
  totalImpressions Int?      @default(0) @map("total_impressions")
  totalConversions Int?      @default(0) @map("total_conversions")
  platform         String?   @default("meta")
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  campaign         Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([campaignId, date, breakdownType, platform])
  @@index([campaignId], map: "idx_breakdowns_campaign")
  @@index([campaignId, breakdownType, date(sort: Desc)], map: "idx_breakdowns_campaign_type")
  @@index([date(sort: Desc)], map: "idx_breakdowns_date")
  @@index([breakdownType], map: "idx_breakdowns_type")
  @@map("metrics_breakdowns")
}

model AuditEvent {
  id              String   @id @default(uuid())
  eventType       String
  processId       String?
  clientId        String
  userId          String
  userRole        String
  resource        Json
  action          String
  changes         Json?
  metadata        Json
  complianceFlags Json
  timestamp       DateTime @default(now()) @db.Timestamp(6)

  @@index([clientId])
  @@index([eventType])
  @@index([timestamp])
  @@map("audit_events")
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  name              String
  role              String
  passwordHash      String
  createdAt         DateTime            @default(now()) @db.Timestamp(6)
  updatedAt         DateTime            @updatedAt @db.Timestamp(6)
  action_approvals  action_approvals[]
  action_executions action_executions[]
  action_proposals  action_proposals[]

  @@map("users")
}

model Lock {
  id           String   @id @default(uuid())
  resourceType String
  resourceId   String
  clientId     String
  holderId     String
  holderType   String
  priority     Int
  status       String
  acquiredAt   DateTime @default(now()) @db.Timestamp(6)
  expiresAt    DateTime @db.Timestamp(6)

  @@unique([resourceType, resourceId])
  @@index([status])
  @@index([expiresAt])
  @@map("locks")
}

model ProcessVersion {
  id              String    @id @default(uuid())
  processId       String
  version         String
  status          String
  description     String
  breaking        Boolean   @default(false)
  rollbackVersion String?
  deployedAt      DateTime  @default(now()) @db.Timestamp(6)
  deprecatedAt    DateTime? @db.Timestamp(6)
  metadata        Json

  @@unique([processId, version])
  @@index([processId])
  @@index([status])
  @@map("process_versions")
}

model ClientBPMNProgress {
  id                  String    @id @default(uuid())
  clientId            String    @map("client_id")
  currentSubprocess   String    @map("current_subprocess")
  status              String?   @default("in_progress")
  progressPercentage  Int?      @default(0) @map("progress_percentage")
  completedTasks      String[]  @map("completed_tasks")
  pendingTasks        String[]  @map("pending_tasks")
  blockedTasks        String[]  @map("blocked_tasks")
  startedAt           DateTime? @map("started_at") @db.Timestamp(6)
  estimatedCompletion DateTime? @map("estimated_completion") @db.Timestamp(6)
  completedAt         DateTime? @map("completed_at") @db.Timestamp(6)
  notes               String?
  blockers            Json?
  metadata            Json?
  subprocessHistory   Json?     @map("subprocess_history")
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  clients             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([clientId, currentSubprocess])
  @@index([clientId], map: "idx_client_bpmn_progress_client_id")
  @@index([status], map: "idx_client_bpmn_progress_status")
  @@index([currentSubprocess], map: "idx_client_bpmn_progress_subprocess")
  @@map("client_bpmn_progress")
}

model MonthlyReport {
  id          String    @id @default(uuid())
  clientId    String    @map("client_id")
  reportType  String?   @default("monthly") @map("report_type")
  periodStart DateTime  @map("period_start") @db.Date
  periodEnd   DateTime  @map("period_end") @db.Date
  title       String
  summaryData Json      @map("summary_data")
  filePath    String?   @map("file_path")
  fileSize    Int?      @map("file_size")
  pdfUrl      String?   @map("pdf_url")
  generatedBy String?   @map("generated_by")
  generatedAt DateTime? @default(now()) @map("generated_at") @db.Timestamp(6)
  version     Int?      @default(1)
  status      String?   @default("generated")
  metadata    Json?
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([clientId], map: "idx_monthly_reports_client_id")
  @@index([clientId, periodStart(sort: Desc)], map: "idx_monthly_reports_client_period")
  @@index([generatedAt(sort: Desc)], map: "idx_monthly_reports_generated_at")
  @@index([periodStart, periodEnd], map: "idx_monthly_reports_period")
  @@map("monthly_reports")
}

model SyncHistory {
  id                String    @id @default(uuid())
  platform          String    @default("meta")
  accountId         String?   @map("account_id")
  dateRangeStart    DateTime  @map("date_range_start") @db.Date
  dateRangeEnd      DateTime  @map("date_range_end") @db.Date
  status            String
  totalInsights     Int?      @default(0) @map("total_insights")
  mappedCampaigns   Int?      @default(0) @map("mapped_campaigns")
  updatedMetrics    Int?      @default(0) @map("updated_metrics")
  unmappedCampaigns String[]  @map("unmapped_campaigns")
  durationMs        Int?      @map("duration_ms")
  startedAt         DateTime  @map("started_at") @db.Timestamp(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamp(6)
  errorMessage      String?   @map("error_message")
  errorStack        String?   @map("error_stack")
  dryRun            Boolean?  @default(false) @map("dry_run")
  triggeredBy       String?   @map("triggered_by")
  metadata          Json?
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  metaGovernanceIssues MetaGovernanceIssue[]
  @@index([accountId, startedAt(sort: Desc)], map: "idx_sync_history_account")
  @@index([platform], map: "idx_sync_history_platform")
  @@index([startedAt(sort: Desc)], map: "idx_sync_history_started_at")
  @@index([status], map: "idx_sync_history_status")
  @@map("sync_history")
}

model MetaGovernanceIssue {
  id                  String      @id @default(uuid())
  issueKey            String      @unique @map("issue_key")
  syncId              String      @map("sync_id")
  clientId            String      @map("client_id")
  accountId           String?     @map("account_id")
  entityType          String      @map("entity_type")
  entityExternalId    String      @map("entity_external_id")
  campaignId          String?     @map("campaign_id")
  issueType           String      @map("issue_type")
  status              String
  currentName         String?     @map("current_name")
  expectedName        String?     @map("expected_name")
  currentCreatedTime  DateTime?   @map("current_created_time") @db.Timestamp(6)
  expectedCreatedTime DateTime?   @map("expected_created_time") @db.Timestamp(6)
  beforePayload       Json?       @map("before_payload")
  afterPayload        Json?       @map("after_payload")
  metaError           String?     @map("meta_error")
  dbError             String?     @map("db_error")
  details             Json?
  firstSeenAt         DateTime    @default(now()) @map("first_seen_at") @db.Timestamp(6)
  lastSeenAt          DateTime    @default(now()) @map("last_seen_at") @db.Timestamp(6)
  resolvedAt          DateTime?   @map("resolved_at") @db.Timestamp(6)
  autoFixed           Boolean     @default(false) @map("auto_fixed")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamp(6)
  syncHistory         SyncHistory @relation(fields: [syncId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  client              Client      @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  campaign            Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull, onUpdate: NoAction)

